+        if (auto *AS = dyn_cast<AliasSummary>(Summary.second))
+          Callback({AS->getAliaseeGUID(), &AS->getAliasee()}, true);
+      }
     } else {
       for (auto &Summaries : Index)
         for (auto &Summary : Summaries.second.getSummaryList())
